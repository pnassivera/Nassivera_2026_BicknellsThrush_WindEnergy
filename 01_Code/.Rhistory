# 1. Lire le polygone officiel utilisé dans l'analyse
seigneurie_check <- sf::st_read(
gdb_path,
layer = "Seigneurie_de_Beaupre",
quiet = TRUE
) |>
sf::st_make_valid()
# 2. Vérifier le CRS
sf::st_crs(seigneurie_check)
# 3. Calculer sa superficie réelle
area_seigneurie_m2 <- sum(sf::st_area(seigneurie_check))
area_seigneurie_ha <- as.numeric(units::set_units(area_seigneurie_m2, ha))
area_seigneurie_km2 <- area_seigneurie_ha / 100
cat("Surface Seigneurie :\n")
cat(round(area_seigneurie_ha, 2), "ha\n")
cat(round(area_seigneurie_km2, 2), "km2\n")
pix_ha <- prod(terra::res(r_class_pre)) / 10000
n_mit <- terra::global(r_class_pre == 1, "sum", na.rm = TRUE)[1,1]
n_pro <- terra::global(r_class_pre == 2, "sum", na.rm = TRUE)[1,1]
mit_ha <- n_mit * pix_ha
pro_ha <- n_pro * pix_ha
total_hab_ha <- mit_ha + pro_ha
cat("Pixel area :", pix_ha, "ha\n")
cat("Mitigation :", mit_ha, "ha\n")
cat("Protection :", pro_ha, "ha\n")
cat("Total :", total_hab_ha, "ha\n")
cat("Mitigation % :", 100 * mit_ha / area_seigneurie_ha, "\n")
cat("Protection % :", 100 * pro_ha / area_seigneurie_ha, "\n")
cat("Total % :", 100 * total_hab_ha / area_seigneurie_ha, "\n")
# Vérification directe via landscapemetrics,
# puisque c'est cette méthode qui alimente les analyses principales
ca_check <- landscapemetrics::lsm_c_ca(r_class_pre)
print(ca_check)
# Fréquence exacte des classes
terra::freq(r_class_pre)
# Vérifier l'étendue spatiale réellement renseignée du raster
pix_ha <- prod(terra::res(r_class_pre)) / 10000
n_valid <- terra::global(!is.na(r_class_pre), "sum", na.rm = TRUE)[1,1]
valid_area_ha <- n_valid * pix_ha
cat("Surface raster non-NA :", valid_area_ha, "ha\n")
cat("Surface polygone Seigneurie :", area_seigneurie_ha, "ha\n")
cat("Différence :", area_seigneurie_ha - valid_area_ha, "ha\n")
# Surface totale du polygone
cat("Polygone Seigneurie :", area_seigneurie_ha, "ha\n\n")
# Surface non-NA dans le SDM pré-développement actuellement chargé
n_valid_predev <- terra::global(
!is.na(r_predev_full),
"sum",
na.rm = TRUE
)[1,1]
area_valid_predev <- n_valid_predev * pix_ha
cat("Surface non-NA r_predev_full :", area_valid_predev, "ha\n")
# Surface du masque d'eau sur la grille
n_water <- terra::global(
!is.na(r_water),
"sum",
na.rm = TRUE
)[1,1]
area_water <- n_water * pix_ha
cat("Surface du masque d'eau :", area_water, "ha\n")
# Retrouver le raster pré-développement AVANT masque d'eau
predev_unmasked_file <- list.files(
dir_ras,
pattern = "^SDM_predev_injected_North_IDW_beta_.*_n_.*\\.tif$",
full.names = TRUE
)
predev_unmasked_file
r_predev_unmasked <- terra::rast(predev_unmasked_file[1])
n_valid_unmasked <- terra::global(
!is.na(r_predev_unmasked),
"sum",
na.rm = TRUE
)[1,1]
area_valid_unmasked <- n_valid_unmasked * pix_ha
cat("Avant masque d'eau :", area_valid_unmasked, "ha\n")
cat("Après masque d'eau :", area_valid_predev, "ha\n")
cat(
"Surface retirée par masque d'eau :",
area_valid_unmasked - area_valid_predev,
"ha\n"
)
rcl_check <- matrix(c(
-Inf, 0.103, 0,
0.103, 0.194, 1,
0.194, Inf, 2
), ncol = 3, byrow = TRUE)
r_class_unmasked <- terra::classify(
r_predev_unmasked,
rcl_check,
include.lowest = TRUE,
right = FALSE
)
n_mit_unmasked <- terra::global(
r_class_unmasked == 1,
"sum",
na.rm = TRUE
)[1,1]
n_pro_unmasked <- terra::global(
r_class_unmasked == 2,
"sum",
na.rm = TRUE
)[1,1]
cat("Mitigation avant masque :", n_mit_unmasked * pix_ha, "ha\n")
cat("Protection avant masque :", n_pro_unmasked * pix_ha, "ha\n")
cat(
"Total avant masque :",
(n_mit_unmasked + n_pro_unmasked) * pix_ha,
"ha\n"
)
